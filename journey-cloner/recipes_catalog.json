  "chain_composer": {
    "_doc": "For journeys no recipe covers. Activities may repeat, branch, or use a choosable flow. `inline_keys` lists the keys that go DIRECTLY on the node object — {\"type\": \"freespins\", \"spins\": 30} — never wrapped in a nested \"settings\" object. `game` accepts any name/id/alias from the games registry and sets the whole id tuple; unknown names are REFUSED, never guessed. Build with `journey_composer.py compose <file> --script`.",
    "sources": {
      "csv/segment": "dwh_source (segment/CSV-seeded audience)",
      "api": "external_system_source (API entry) — use this for a journey a randomizer routes winners into",
      "promocode": "registration (Reference codes entry; takes `promocode`)"
