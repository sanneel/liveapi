      "knobs": {
        "deposit_min_clp": {
          "wire_unit": "minor",
          "desc": "minimum deposit to unlock, in CLP",
          "range": [
            0,
            1000000
          ]
        },
        "spins": {
          "wire_unit": "raw",
          "desc": "number of free spins granted",
          "range": [
            1,
            10000
          ]
        },
        "spin_bet_clp": {
          "wire_unit": "minor",
          "desc": "bet value per spin, in CLP",
          "range": [
            10,
            20000
          ]
        },
        "bonus_percent": {
          "wire_unit": "raw",
          "desc": "deposit-match percent (100 = 100%)",
          "range": [
            0,
            1000
          ]
        },
        "wagering_x": {
          "wire_unit": "raw",
          "desc": "wagering multiplier (e.g. 30 = x30)",
          "range": [
            0,
            100
          ]
        },
        "bonus_expiry_ms": {
          "wire_unit": "raw",
          "desc": "bonus validity in milliseconds (172800000 = 48h)"
        },
        "release_limit_x": {
          "wire_unit": "raw",
          "desc": "max cashout as a multiple of the bonus",
          "range": [
            0,
            100
          ]
        },
        "spin_max_bonus_clp": {
          "wire_unit": "minor",
          "desc": "cap on winnings from the spins, in CLP",
          "range": [
            0,
            100000000
          ]
        },
        "spin_min_bonus_clp": {
          "wire_unit": "minor",
          "desc": "minimum winnings paid from the spins, in CLP",
          "range": [
            0,
            100000000
          ]
        }
      }
    },
