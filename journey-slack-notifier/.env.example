# --- Tableau Server ---
# Base URL of your Tableau Server, no trailing slash, e.g. https://tableau.euc1.prod-analytics.aws.tech-ops.cloud
TABLEAU_SERVER_URL=
# Content URL of the site the dashboard lives on. Leave blank for the Default site.
# (Check the URL when browsing the dashboard: .../#/site/<this-part>/... - if there's
# no /site/ segment, leave this blank.)
TABLEAU_SITE_CONTENT_URL=
# REST API version supported by your server. Check with a VERSIONED path:
#   GET {TABLEAU_SERVER_URL}/api/3.27/serverinfo   -> read <restApiVersion>
# (The unversioned /api/-/serverinfo returns a JSON 404 on our server.)
TABLEAU_API_VERSION=3.27
# Personal Access Token - see README "1. Tableau Personal Access Token"
TABLEAU_PAT_NAME=
TABLEAU_PAT_SECRET=
TABLEAU_WORKBOOK_NAME=Journey Flow Report
TABLEAU_VIEW_NAME=Journey Funnel Dashboard

# --- Column names in the exported data ---
# Run `python3 journey_slack_notifier.py --list-columns` after filling in the
# Tableau section above, then set these three to match the real headers.
JOURNEY_ID_FIELD=Journey Id
JOURNEY_NAME_FIELD=Journey Name
JOURNEY_STATUS_FIELD=
JOURNEY_FINISHED_VALUE=Finished

# --- Where to deliver: telegram | slack | both ---
NOTIFY_TARGET=telegram

# --- Telegram ---
# Leave blank to reuse the main app's ../.env values (app/config.py). Set only
# to send to a different bot or chat than the app's alert channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Slack ---
# Must be the Bot User OAuth Token (starts xoxb-). A user token (xoxp-) or a
# token-refresh credential (xoxe-) will be rejected: files_upload_v2 needs a bot.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CHANNEL_ID=C0123456789

# --- Local state ---
STATE_FILE_PATH=./state/sent_journeys.json
LOG_FILE_PATH=./state/notifier.log
